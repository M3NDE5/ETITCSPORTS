// Firestore Security Rules
// Copiar estas reglas en Firebase Console -> Firestore Database -> Rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permitir lectura y escritura a todos (para desarrollo)
    // EN PRODUCCIÓN: Cambiar a reglas más restrictivas
    match /torneos/{document=**} {
      allow read, write: if true;
    }
    
    // Otras colecciones pueden ir aquí
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// NOTA: Las reglas anteriores permiten acceso público.
// Para seguridad en producción, usar autenticación:
/*
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /torneos/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
*/
